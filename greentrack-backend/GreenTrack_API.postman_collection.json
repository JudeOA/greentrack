{
  "info": {
    "name": "GreenTrack API",
    "description": "Smart Waste Management System — KNUST 2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080/api" },
    { "key": "citizenToken", "value": "" },
    { "key": "collectorToken","value": "" },
    { "key": "adminToken",   "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Citizen",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ama Darko\",\n  \"email\": \"ama@test.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"+233201234567\",\n  \"role\": \"CITIZEN\"\n}"
            }
          }
        },
        {
          "name": "Register Collector",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kofi Mensah\",\n  \"email\": \"kofi@test.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"+233209876543\",\n  \"role\": \"COLLECTOR\",\n  \"badgeId\": \"GT-COL-001\"\n}"
            }
          }
        },
        {
          "name": "Login Citizen",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data) pm.collectionVariables.set('citizenToken', res.data.accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ama@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data) pm.collectionVariables.set('adminToken', res.data.accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@greentrack.app\",\n  \"password\": \"Admin@2026\"\n}"
            }
          }
        },
        {
          "name": "Login Collector",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.data) pm.collectionVariables.set('collectorToken', res.data.accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kofi@test.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        }
      ]
    },

    {
      "name": "Reports",
      "item": [
        {
          "name": "Submit Report (with photo)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reports",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "data", "value": "{\"title\":\"Overflowing bin near Adum\",\"description\":\"Bin is completely full\",\"categoryId\":1,\"latitude\":6.688527,\"longitude\":-1.624354,\"address\":\"Adum Market, Kumasi\",\"priority\":\"HIGH\"}", "type": "text", "contentType": "application/json" },
                { "key": "images", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Get All Reports (Admin)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports?page=0&size=20", "query": [
              { "key": "page",   "value": "0" },
              { "key": "size",   "value": "20" },
              { "key": "status", "value": "PENDING", "disabled": true }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get My Reports (Citizen)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/my?page=0&size=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Get Nearby Reports",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/nearby?lat=6.6885&lng=-1.6244&radius=2000", "query": [
              { "key": "lat",    "value": "6.6885" },
              { "key": "lng",    "value": "-1.6244" },
              { "key": "radius", "value": "2000" }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Get Single Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Update Report Status (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/reports/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"notes\": \"Cleaned up by team A\"\n}"
            }
          }
        },
        {
          "name": "Delete Report (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/reports/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Assignments",
      "item": [
        {
          "name": "Assign Report to Collector (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/assignments",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": 1,\n  \"collectorId\": 2,\n  \"notes\": \"Urgent — please attend within 2 hours\"\n}"
            }
          }
        },
        {
          "name": "Get My Tasks (Collector)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assignments/mine?page=0&size=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{collectorToken}}" }]
          }
        },
        {
          "name": "Update Task Status — En Route",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/assignments/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{collectorToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\": \"EN_ROUTE\"}" }
          }
        },
        {
          "name": "Update Task Status — Completed",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/assignments/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{collectorToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\": \"COMPLETED\"}" }
          }
        },
        {
          "name": "Upload Proof Photo (Collector)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/assignments/1/proof",
            "header": [{ "key": "Authorization", "value": "Bearer {{collectorToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "proofImage", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications?page=0&size=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications/unread-count",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/1/read",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/read-all",
            "header": [{ "key": "Authorization", "value": "Bearer {{citizenToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Dashboard Stats (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/analytics/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users?page=0&size=20",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Active Collectors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/collectors",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Single User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"active\": false}" }
          }
        }
      ]
    }

  ]
}
